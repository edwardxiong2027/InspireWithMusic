rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && currentProfile().status == "active";
    }

    function volunteerAdmin() {
      return activeUser() && currentProfile().role == "volunteer_admin";
    }

    function webmaster() {
      return activeUser()
        && currentProfile().role == "webmaster"
        && currentProfile().email == "inspirewithmusic.org@gmail.com"
        && request.auth.token.email == "inspirewithmusic.org@gmail.com";
    }

    function eventCreator() {
      return volunteerAdmin() || webmaster();
    }

    function validMembership(value) {
      return value in ["website_user", "official_member"];
    }

    function bootstrapWebmaster() {
      return request.auth.token.email == "inspirewithmusic.org@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "active"
        && validMembership(request.resource.data.membership_status)
        && (
          (request.resource.data.role == "website_user" && request.resource.data.membership_status == "website_user")
          || (request.resource.data.role == "webmaster" && request.resource.data.membership_status == "official_member" && bootstrapWebmaster())
        );
      allow read: if signedIn() && (request.auth.uid == userId || eventCreator());
      allow update: if (webmaster()
          && request.resource.data.role in ["website_user", "member", "volunteer_admin", "webmaster"]
          && validMembership(request.resource.data.membership_status)
          && (request.resource.data.role != "webmaster"
            || request.resource.data.email == "inspirewithmusic.org@gmail.com")
          && (resource.data.email != "inspirewithmusic.org@gmail.com"
            || (request.resource.data.role == "webmaster" && request.resource.data.status == "active")))
        || (volunteerAdmin()
          && resource.data.role in ["website_user", "member"]
          && request.resource.data.role in ["website_user", "member"]
          && validMembership(request.resource.data.membership_status)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["membership_status", "updated_at"]))
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "phone", "instrument", "updated_at"]));
      allow delete: if webmaster() && resource.data.email != "inspirewithmusic.org@gmail.com";
    }

    match /deleted_users/{userId} {
      allow read: if false;
      allow create, update, delete: if webmaster();
    }

    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if webmaster();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if eventCreator()
        && request.resource.data.audience in ["all_users", "official_members"]
        && request.resource.data.ends_at_timestamp > request.resource.data.starts_at_timestamp;
      allow delete: if webmaster();
      allow update: if (eventCreator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "description", "location", "starts_at", "ends_at", "starts_at_timestamp", "ends_at_timestamp", "capacity", "service_minutes", "status", "audience", "signup_count", "updated_at"])
          && request.resource.data.audience in ["all_users", "official_members"]
          && request.resource.data.ends_at_timestamp > request.resource.data.starts_at_timestamp
          && request.resource.data.signup_count >= 0
          && request.resource.data.signup_count <= request.resource.data.capacity)
        || (activeUser()
          && currentProfile().role in ["website_user", "member"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["signup_count", "updated_at"])
          && request.resource.data.signup_count >= 0
          && request.resource.data.signup_count <= resource.data.capacity
          && (
            (request.resource.data.signup_count == resource.data.signup_count + 1
              && existsAfter(/databases/$(database)/documents/events/$(eventId)/signups/$(request.auth.uid)))
            || (request.resource.data.signup_count == resource.data.signup_count - 1
              && !existsAfter(/databases/$(database)/documents/events/$(eventId)/signups/$(request.auth.uid)))
          ));

      match /signups/{userId} {
        allow read: if activeUser() && (request.auth.uid == userId || eventCreator());
        allow create: if (eventCreator()
            && request.resource.data.user_id == userId
            && request.resource.data.attendance_status == "pending"
            && (!get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(["audience"])
              || get(/databases/$(database)/documents/events/$(eventId)).data.audience != "official_members"
              || get(/databases/$(database)/documents/users/$(userId)).data.role == "member"))
          || (activeUser()
            && request.auth.uid == userId
            && request.resource.data.user_id == request.auth.uid
            && get(/databases/$(database)/documents/events/$(eventId)).data.status == "open"
            && (!get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(["starts_at_timestamp"])
              || request.time < get(/databases/$(database)/documents/events/$(eventId)).data.starts_at_timestamp)
            && (!get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(["audience"])
              || get(/databases/$(database)/documents/events/$(eventId)).data.audience != "official_members"
              || currentProfile().role == "member"));
        allow delete: if activeUser() && (request.auth.uid == userId || eventCreator());
        allow update: if eventCreator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["attendance_status", "attendance_confirmed_by", "attendance_confirmed_at", "updated_at"])
          && request.resource.data.attendance_status in ["pending", "attended", "absent"];
      }
    }

    match /service_hours/{hourId} {
      allow read: if activeUser() && (resource.data.user_id == request.auth.uid || volunteerAdmin() || webmaster());
      allow create: if activeUser()
        && request.resource.data.minutes > 0
        && ((currentProfile().role == "member"
            && request.resource.data.user_id == request.auth.uid
            && request.resource.data.event_id == null
            && request.resource.data.status == "pending")
          || (eventCreator()
            && request.resource.data.event_id is string
            && request.resource.data.source == "event_attendance"
            && request.resource.data.minutes == get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.service_minutes
            && request.resource.data.status in ["verified", "rejected"]));
      allow update: if (webmaster()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "verified_by", "verified_at", "updated_at"])
          && request.resource.data.status in ["verified", "rejected"])
        || (eventCreator()
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.event_id == resource.data.event_id
          && request.resource.data.event_id is string
          && request.resource.data.source == "event_attendance"
          && request.resource.data.minutes == get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.service_minutes
          && request.resource.data.status in ["verified", "rejected"]);
      allow delete: if false;
    }

    match /stories/{storyId} {
      allow read: if resource.data.status == "published"
        || (activeUser() && resource.data.author_id == request.auth.uid)
        || webmaster();
      allow create: if activeUser()
        && currentProfile().role == "member"
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.status == "submitted";
      allow update: if (webmaster()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "excerpt", "body", "cover_url", "status", "reviewer_id", "published_at", "updated_at"]))
        || (activeUser()
          && currentProfile().role == "member"
          && resource.data.author_id == request.auth.uid
          && resource.data.status == "submitted"
          && request.resource.data.status == "submitted"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "excerpt", "body", "cover_url", "updated_at"]));
      allow delete: if webmaster();
    }

    match /media_assets/{assetId} {
      allow read: if true;
      allow create, update, delete: if webmaster();
    }

    match /media_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if webmaster();
    }

    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "interest", "message", "status", "created_at"])
        && request.resource.data.status == "new"
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10;
      allow read, update, delete: if webmaster();
    }

    match /newsletter_subscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasOnly(["email", "status", "created_at"])
        && request.resource.data.status == "active"
        && request.resource.data.email is string;
      allow read, update, delete: if webmaster();
    }

    match /settings/{settingId} {
      allow read, create, update, delete: if webmaster();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
