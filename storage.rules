rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function activeUser() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function webmaster() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == "active"
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "webmaster";
    }

    match /media/{fileName} {
      allow read: if true;
      allow write: if webmaster()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    match /story-submissions/{userId}/{fileName} {
      allow read: if true;
      allow create: if activeUser()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow update, delete: if webmaster();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
