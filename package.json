{
  "name": "inspire-with-music",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "build:firebase": "vite build --config vite.pages.config.ts --base /",
    "start": "next start",
    "test": "node --test tests/rendered-html.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-inspirewithmusic \"node --test tests/firebase-rules.test.mjs\"",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "firebase:serve": "npm run build:firebase && firebase emulators:start --only hosting,auth,firestore,storage",
    "firebase:deploy": "npm run build:firebase && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  },
  "type": "module"
}
